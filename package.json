{
    "name": "load-available-actions",
    "version": "0.0.1",
    "private": false,
    "description": "GitHub Action to load all available runner information for an organization",
    "main": "lib/main.js",
    "scripts": {
        "compile": "tsc",
        "esbuild": "esbuild src/main.ts --bundle --outdir=dist --platform=node --external:vscode --external:@vscode/test-electron --external:jest",
        "format": "prettier --write **/*.ts",
        "format-check": "prettier --check **/*.ts",
        "lint": "eslint src/**/*.ts",
        "package": "npm run esbuild",
        "test": "jest --passWithNoTests",
        "all": "npm run esbuild && npm run test # && npm run lint"
    },
    "engines": {
        "node": ">=24"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/devops-actions/load-runner-info.git"
    },
    "keywords": [
        "GitHub Actions",
        "Load available runner information from a GitHub organization"
    ],
    "author": "@rajbos",
    "license": "MIT",
    "dependencies": {
        "@actions/core": "^3.0.1",
        "moment": "^2.31.0",
        "octokit": "^5.0.5",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^26.6.3",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.62.1",
        "@vercel/ncc": "^0.45.0",
        "ansi-regex": ">=6.4.0",
        "dotenv": "^18.0.4",
        "esbuild": "^0.28.2",
        "eslint": "^10.11.0",
        "eslint-plugin-github": "^6.1.2",
        "eslint-plugin-jest": "^29.16.6",
        "jest": "^30.5.2",
        "js-yaml": "^5.4.2",
        "prettier": "3.9.9",
        "tmpl": ">=1.0.5",
        "ts-jest": "^29.4.14",
        "typescript": "^6.0.3"
    },
    "optionalDependencies": {
        "fsevents": "^2.3.3"
    },
    "overrides": {
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^3.15.0"
        },
        "@babel/core": "^7.29.6"
    }
}
